# =====================================================================
# HOUSEHOLD EXPENSE TRACKER - CONFIGURATION & ENVIRONMENT VARIABLES
# =====================================================================

# 1. AUTHENTICATION (NO LOGIN REQUIRED BY DEFAULT)
# ---------------------------------------------------------------------
# Direct access enabled by default. No login credentials needed.

# 2. DATA STORAGE MODE: SERVER JSON FILE (ACTIVE)
# ---------------------------------------------------------------------
# Expenses are automatically read from and written to data/expenses.json
# All new inserts, updates, deletes and Excel imports sync directly into the JSON file.
DATA_STORE_MODE=json_file

# Note: Google Sheets API is NOT required. Everything is maintained directly on the server in JSON format.

# ---------------------------------------------------------------------
# OPTION B: HOSTED DATABASE CONFIGURATION (RECOMMENDED FOR HIGH SPEED)
# ---------------------------------------------------------------------
# MongoDB Atlas Connection URI (if DATA_STORE_MODE=mongodb)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/household_db?retryWrites=true&w=majority

# Supabase PostgreSQL / REST API (if DATA_STORE_MODE=supabase)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vercel KV / Upstash Redis (if DATA_STORE_MODE=kv)
KV_REST_API_URL=https://your-kv-db.upstash.io
KV_REST_API_TOKEN=your-kv-rest-token
