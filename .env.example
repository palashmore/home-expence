# =====================================================================
# HOME EXPENCE - ENVIRONMENT VARIABLES
# =====================================================================
# Copy to .env and fill in. .env is gitignored - never commit real values.
# Generate the secrets with:  npm run keys
# Full deployment walkthrough: DEPLOYMENT.md
# =====================================================================

# ---------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------

# Signs session tokens. Must be 32+ characters and randomly generated.
# In production the app REFUSES TO START if this is missing, too short, or
# left at the old hardcoded value - without it anyone could forge a session
# for any household or role.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
JWT_SECRET=

# ---------------------------------------------------------------------
# PUSH NOTIFICATIONS (optional, but required for push to survive a restart)
# ---------------------------------------------------------------------

# Each device's push subscription is bound to the public key it saw when it
# subscribed. On serverless the filesystem is read-only, so without these the
# app generates a new pair on every cold start and every subscription silently
# stops working. Generate a pair with:  npm run keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact address sent with push requests. Defaults to a placeholder.
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------
# CLOUD SYNC (GitHub Gist) - household H001 only
# ---------------------------------------------------------------------

# Set to 1 to disable Gist sync entirely (reads and writes).
# The test runners set this automatically so a test never touches the gist.
CLOUD_SYNC_DISABLED=

# The gist used for cross-device persistence. There is a public default in the
# source - set your own before relying on it.
GIST_ID=

# Token with the "gist" scope. Without it, Gist writes are skipped.
GITHUB_TOKEN=

# ---------------------------------------------------------------------
# STORAGE LOCATIONS (normally leave blank)
# ---------------------------------------------------------------------

# Override where household data is read from and written to. The test runners
# point these at a scratch copy so a test run never touches real data.
HOMEEXPENSES_DATA_DIR=
HOMEEXPENSES_TMP_DIR=

# ---------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------

# Port for `npm start`. Defaults to 8000.
PORT=

# Set to "production" on a real deployment. This is what makes the JWT_SECRET
# check fatal rather than a warning. Vercel sets its own VERCEL variable, which
# the app also treats as production.
NODE_ENV=
