{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "server.js": {
      "includeFiles": "{index.html,styles.css,tracker_app.js,advance_modules.js,sw.js,manifest.json,icon.svg,icon-192.png,icon-512.png,icon-maskable-512.png,apple-touch-icon.png,favicon.ico,og-image.png,data/**}",
      "maxDuration": 15
    },
    "index.js": {
      "includeFiles": "{index.html,styles.css,tracker_app.js,advance_modules.js,sw.js,manifest.json,icon.svg,icon-192.png,icon-512.png,icon-maskable-512.png,apple-touch-icon.png,favicon.ico,og-image.png,data/**}",
      "maxDuration": 15
    },
    "api/*.js": {
      "includeFiles": "data/**",
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ]
}
